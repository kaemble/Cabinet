#!/usr/bin/env python3
"""Package this release directory. Generated by packaging/debian/build.py."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

CONFIG = @CONFIG@

APPRUN = r'''#!/bin/sh
set -eu
appdir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
export PATH="$appdir/usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$appdir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$appdir/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
: "${HOME:?HOME must be set}"
system="$HOME/.local/share/cabinet/system"
mkdir -p -- "$system"
# Include hidden entries in the emptiness check. -n also protects files created
# between the check and copy, including during simultaneous first launches.
first_entry=$(find -H "$system" -mindepth 1 -maxdepth 1 -print -quit)
if [ -z "$first_entry" ]; then
    cp -R -n -- "$appdir/usr/share/cabinet/cores/system/." "$system/"
fi
'''

ARMADA_ENV = r'''eval "$(/usr/libexec/armada/device-env)"
# Enable --dual-screen on the devices that support it.
if [ -n "${ARMADA_SECONDARY_CONNECTOR:-}" ]; then
    export CABINET_DUAL_SCREEN=1
fi
'''


def app_run(preset):
    device_env = ARMADA_ENV if preset == "ArmadaOS" else ""
    return APPRUN + device_env + 'exec "$appdir/usr/bin/cabinet" "$@"\n'


DESKTOP = '''[Desktop Entry]
Type=Application
Name=Cabinet
Comment=Game library and libretro frontend
Exec=cabinet %F
Icon=cabinet
Terminal=false
Categories=Game;Emulator;
'''

ICON = '''<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">
<rect width="256" height="256" rx="48" fill="#202530"/>
<path d="M60 40h136v104l20 72H40l20-72z" fill="#74c7b8"/>
<rect x="76" y="56" width="104" height="80" rx="8" fill="#202530"/>
<path d="M82 172h28m-14-14v28" stroke="#202530" stroke-width="10"/>
<circle cx="160" cy="168" r="8" fill="#202530"/>
<circle cx="184" cy="184" r="8" fill="#202530"/>
</svg>
'''

# Keep glibc, compiler runtimes, and the graphics/window-system stack supplied
# by the target OS. Even with a host Vulkan loader, bundled older libstdc++ or
# Wayland libraries can prevent its ICDs/layers from loading (missing symbols),
# which SDL can report as a missing VK_KHR_surface extension.
SYSTEM_LIBRARIES = re.compile(
    r"^(?:ld-linux.*|lib(?:c|m|mvec|dl|pthread|rt|resolv|util|anl)\.so\..*|"
    r"lib(?:stdc\+\+|gcc_s)\.so\..*|"
    r"lib(?:GL|GLX|GLdispatch|OpenGL|EGL|GLESv1_CM|GLESv2|vulkan|gbm|drm|drm_.*)\.so\..*|"
    r"lib(?:wayland-.*|X[\w-]+|xcb(?:-.*)?|xkbcommon(?:-.*)?)\.so\..*)$")


def run(command, **kwargs):
    print("+", " ".join(map(str, command)), flush=True)
    return subprocess.run(list(map(str, command)), check=True, **kwargs)


def bundle_libraries(appdir, arch):
    """Resolve target DT_NEEDED entries without executing cross-built binaries."""
    triplet = "x86_64-linux-gnu" if arch == "x86_64" else "aarch64-linux-gnu"
    search = [Path("/usr/lib") / triplet, Path("/lib") / triplet]
    destination = appdir / "usr/lib"
    destination.mkdir(parents=True, exist_ok=True)
    pending = list((appdir / "usr/bin").iterdir())
    pending += list((appdir / "usr/share/cabinet/cores").glob("*.so"))
    visited = set()
    while pending:
        binary = pending.pop()
        dynamic = subprocess.check_output(["readelf", "-d", str(binary)], text=True)
        for name in re.findall(r"\(NEEDED\).*?\[([^]]+)\]", dynamic):
            if name in visited or SYSTEM_LIBRARIES.fullmatch(name):
                continue
            visited.add(name)
            source = next((directory / name for directory in search if (directory / name).is_file()), None)
            if source is None:
                raise RuntimeError(f"Unresolved {arch} dependency: {name} (needed by {binary})")
            target = destination / name
            shutil.copy2(source, target, follow_symlinks=True)
            pending.append(target)
            # Preserve the Debian copyright/license notices for bundled libraries.
            owner = subprocess.check_output(["dpkg-query", "-S", str(source.resolve())], text=True)
            package = owner.split(": ", 1)[0].split(":", 1)[0]
            copyright_file = Path("/usr/share/doc") / package / "copyright"
            if copyright_file.is_file():
                notices = appdir / "usr/share/cabinet/licenses" / package
                notices.mkdir(parents=True, exist_ok=True)
                shutil.copy2(copyright_file, notices / "copyright")


def stage(output):
    # cmake --install verifies the complete locked bundle, including architecture,
    # checksums and system assets, before installing it in the relocatable layout.
    with tempfile.TemporaryDirectory(prefix=".cabinet-appdir-", dir=output) as temporary:
        appdir = Path(temporary) / "Cabinet.AppDir"
        run(["cmake", "--install", output / "cabinet", "--prefix", appdir / "usr"])
        for name in ("cabinet", "cabinet-runner"):
            if not (appdir / "usr/bin" / name).is_file():
                raise RuntimeError(f"Missing {name}; build the cabinet target first")
        (appdir / "usr/share/cabinet/cores/system").mkdir(parents=True, exist_ok=True)
        bundle_libraries(appdir, CONFIG["arch"])
        for name in ("build-environment.json", "debian-packages.txt"):
            shutil.copy2(output / name, appdir / "usr/share/cabinet" / name)
        (appdir / "AppRun").write_text(app_run(CONFIG["preset"]))
        (appdir / "AppRun").chmod(0o755)
        (appdir / "cabinet.desktop").write_text(DESKTOP)
        (appdir / "cabinet.svg").write_text(ICON)
        (appdir / ".DirIcon").symlink_to("cabinet.svg")
        # The old AppDir stays available if staging or dependency resolution fails.
        previous = output / "Cabinet.AppDir"
        if previous.exists():
            shutil.rmtree(previous)
        appdir.rename(previous)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--appimagetool", default=os.environ.get("APPIMAGETOOL", "appimagetool"),
                        help="Host-native appimagetool executable (or APPIMAGETOOL)")
    parser.add_argument("--runtime-file", type=Path, help="Optional local runtime for the TARGET architecture")
    parser.add_argument("--stage", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    output = Path.cwd()
    if args.stage:
        stage(output)
        return
    tool = shutil.which(args.appimagetool)
    if not tool:
        parser.error("Install appimagetool or supply --appimagetool /path/to/appimagetool")
    command = ["docker", "run", "--rm", "--platform", CONFIG["docker_platform"],
               "--mount", f"type=bind,src={CONFIG['root']},dst=/src,readonly",
               "--mount", f"type=bind,src={output},dst=/out", "-w", "/out"]
    if hasattr(os, "getuid"):
        command += ["--user", f"{os.getuid()}:{os.getgid()}"]
    run([*command, CONFIG["image_id"], "python3", "/out/package-appimage.py", "--stage"])
    destination = output / f"Cabinet-{CONFIG['preset']}.AppImage"
    options = ["--runtime-file", args.runtime_file.resolve()] if args.runtime_file else []
    run([tool, "--comp", "zstd", *options, output / "Cabinet.AppDir", destination],
        env=dict(os.environ, ARCH=CONFIG["arch"], APPIMAGE_EXTRACT_AND_RUN="1"))
    print(f"AppImage: {destination}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
