include("${ASSET_MANIFEST}")

if(ASSET_KIND STREQUAL "FONT")
  set(ASSET_SOURCE "")
  foreach(ASSET_FILE IN LISTS CABINET_ASSET_FILES)
    get_filename_component(FONT_NAME "${ASSET_FILE}" NAME_WE)
    string(REPLACE "AtkinsonHyperlegibleNext-" "" FONT_NAME "${FONT_NAME}")
    string(TOLOWER "${FONT_NAME}" FONT_NAME)
    file(READ "${ASSET_FILE}" ASSET_HEX HEX)
    string(REGEX REPLACE "(..)" "0x\\1," ASSET_BYTES "${ASSET_HEX}")
    string(APPEND ASSET_SOURCE
      "extern const unsigned char cabinet_${FONT_NAME}_font_data[] = {${ASSET_BYTES}};\nextern const unsigned long cabinet_${FONT_NAME}_font_size = sizeof(cabinet_${FONT_NAME}_font_data);\n")
  endforeach()
elseif(ASSET_KIND STREQUAL "ICON")
  set(ASSET_SOURCE "#include <SDL3/SDL.h>\n#include <string_view>\n")
  set(ICON_LOOKUP "SDL_Surface* load_prompt_icon(std::string_view name) {\n")
  foreach(ASSET_FILE IN LISTS CABINET_ASSET_FILES)
    get_filename_component(ICON_NAME "${ASSET_FILE}" NAME_WE)
    string(MD5 ICON_HASH "${ICON_NAME}")
    set(ICON_SYMBOL "cabinet_icon_${ICON_HASH}")
    file(READ "${ASSET_FILE}" ASSET_HEX HEX)
    string(REGEX REPLACE "(..)" "0x\\1," ASSET_BYTES "${ASSET_HEX}")
    string(APPEND ASSET_SOURCE "static const unsigned char ${ICON_SYMBOL}[] = {${ASSET_BYTES}};\n")
    string(APPEND ICON_LOOKUP "if (name == \"${ICON_NAME}\") return SDL_LoadPNG_IO(SDL_IOFromConstMem(${ICON_SYMBOL}, sizeof(${ICON_SYMBOL})), true);\n")
  endforeach()
  string(APPEND ASSET_SOURCE "${ICON_LOOKUP}return nullptr;\n}\n")
else()
  message(FATAL_ERROR "Unknown asset kind: ${ASSET_KIND}")
endif()

file(WRITE "${ASSET_OUTPUT}" "${ASSET_SOURCE}")
